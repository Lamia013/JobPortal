@model List<JobPortal.Models.Apply>

@{
    ViewData["Title"] = "Applicants List";
}

<h3 class="mb-3">Applicants List</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <h5 class="text-muted fst-italic opacity-50">No applicants yet.</h5>
    </div>
}
else
{
    @* Group applicants by Organization + Job *@
    var grouped = Model
        .GroupBy(a => new { Org = a.Job?.Organization?.OrganizationName, JobTitle = a.Job?.Title });

    foreach (var group in grouped)
    {
        <h5 class="mt-4">@group.Key.Org - @group.Key.JobTitle</h5>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Applicant Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in group)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.Status=="Accepted"?"bg-success": item.Status=="Rejected"?"bg-danger":"bg-warning")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                @if(item.Status != "Accepted")
                                {
                                    <a asp-action="UpdateStatus"
                                       asp-route-id="@item.Id"
                                       asp-route-status="Accepted"
                                       class="btn btn-success btn-sm">
                                       Accept
                                    </a>
                                }

                                @if(item.Status != "Rejected")
                                {
                                    <a asp-action="UpdateStatus"
                                       asp-route-id="@item.Id"
                                       asp-route-status="Rejected"
                                       class="btn btn-danger btn-sm">
                                       Reject
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}